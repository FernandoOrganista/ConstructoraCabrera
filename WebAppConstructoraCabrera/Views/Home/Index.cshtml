@{
    ViewData["Title"] = "Inicio";
    ViewData["ActivePage"] = "Index";
}

<div class="container-fluid px-0 mb-5">
    <div id="header-carousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img class="w-100" src="~/img/carousel-1.jpg" alt="Obra industrial Constructora Cabrera">
                <div class="carousel-caption">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-10 text-start">
                                <p class="fs-5 fw-medium text-primary text-uppercase animated slideInRight">25 años de experiencia en obra</p>
                                <h1 class="display-1 text-white mb-5 animated slideInRight">Ingeniería y construcción de alto desempeño</h1>
                                <a asp-controller="Home" asp-action="About" class="btn btn-primary py-3 px-5 animated slideInRight">Conocer más</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <img class="w-100" src="~/img/carousel-2.jpg" alt="Proyecto de infraestructura">
                <div class="carousel-caption">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-10 text-start">
                                <p class="fs-5 fw-medium text-primary text-uppercase animated slideInRight">Planeación, ejecución y entrega</p>
                                <h1 class="display-1 text-white mb-5 animated slideInRight">Soluciones confiables para la industria</h1>
                                <a asp-controller="Home" asp-action="Services" class="btn btn-primary py-3 px-5 animated slideInRight">Ver servicios</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#header-carousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#header-carousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Siguiente</span>
        </button>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="row gx-3 h-100">
                    <div class="col-6 align-self-start wow fadeInUp" data-wow-delay="0.1s">
                        <img class="img-fluid" src="~/img/about-1.jpg" alt="Equipo en campo">
                    </div>
                    <div class="col-6 align-self-end wow fadeInDown" data-wow-delay="0.1s">
                        <img class="img-fluid" src="~/img/about-2.jpg" alt="Instalaciones">
                    </div>
                </div>
            </div>
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                <p class="fw-medium text-uppercase text-primary mb-2">Nosotros</p>
                <h1 class="display-5 mb-4">Liderazgo en construcción e ingeniería industrial</h1>
                <p class="mb-4">En Constructora Cabrera integramos diseño, supervisión y ejecución para entregar obras seguras, dentro de plazo y con estándares de calidad medibles. Acompañamos a clientes privados e institucionales en cada etapa del proyecto.</p>
                <div class="d-flex align-items-center mb-4">
                    <div class="flex-shrink-0 bg-primary p-4">
                        <h1 class="display-2">25</h1>
                        <h5 class="text-white">Años de</h5>
                        <h5 class="text-white">experiencia</h5>
                    </div>
                    <div class="ms-4">
                        <p><i class="fa fa-check text-primary me-2"></i>Energía e instalaciones</p>
                        <p><i class="fa fa-check text-primary me-2"></i>Obra civil</p>
                        <p><i class="fa fa-check text-primary me-2"></i>Ingeniería mecánica</p>
                        <p><i class="fa fa-check text-primary me-2"></i>Procesos e infraestructura</p>
                        <p class="mb-0"><i class="fa fa-check text-primary me-2"></i>Hidráulica y saneamiento</p>
                    </div>
                </div>
                <div class="row pt-2">
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0 btn-lg-square rounded-circle bg-primary">
                                <i class="fa fa-envelope-open text-white"></i>
                            </div>
                            <div class="ms-3">
                                <p class="mb-2">Correo</p>
                                <h5 class="mb-0">contacto@constructoracabrera.com</h5>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0 btn-lg-square rounded-circle bg-primary">
                                <i class="fa fa-phone-alt text-white"></i>
                            </div>
                            <div class="ms-3">
                                <p class="mb-2">Teléfono</p>
                                <h5 class="mb-0">+52 55 0000 0000</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_Facts" />

<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="position-relative me-lg-4">
                    <img class="img-fluid w-100" src="~/img/feature.jpg" alt="Por qué Constructora Cabrera">
                    <span class="position-absolute top-50 start-100 translate-middle bg-white rounded-circle d-none d-lg-block" style="width: 120px; height: 120px;"></span>
                    <button type="button" class="btn-play" data-bs-toggle="modal" data-src="https://www.youtube.com/embed/DWRcNpR6Kdc" data-bs-target="#videoModal">
                        <span></span>
                    </button>
                </div>
            </div>
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.5s">
                <p class="fw-medium text-uppercase text-primary mb-2">Por qué elegirnos</p>
                <h1 class="display-5 mb-4">Razones para confiar tu obra a Cabrera</h1>
                <p class="mb-4">Combinamos capacidad técnica, control de obra y comunicación clara con el cliente. Cada proyecto se gestiona con programa, presupuesto y seguridad como ejes de decisión.</p>
                <div class="row gy-4">
                    <div class="col-12">
                        <div class="d-flex">
                            <div class="flex-shrink-0 btn-lg-square rounded-circle bg-primary">
                                <i class="fa fa-check text-white"></i>
                            </div>
                            <div class="ms-4">
                                <h4>Personal experimentado</h4>
                                <span>Residentes, superintendentes y especialistas con trayectoria en obra pesada e industrial.</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="d-flex">
                            <div class="flex-shrink-0 btn-lg-square rounded-circle bg-primary">
                                <i class="fa fa-check text-white"></i>
                            </div>
                            <div class="ms-4">
                                <h4>Servicio industrial confiable</h4>
                                <span>Procesos documentados, proveedores calificados y seguimiento de calidad en campo.</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="d-flex">
                            <div class="flex-shrink-0 btn-lg-square rounded-circle bg-primary">
                                <i class="fa fa-check text-white"></i>
                            </div>
                            <div class="ms-4">
                                <h4>Acompañamiento continuo</h4>
                                <span>Atención a solicitudes de cambio, reportes de avance y coordinación con tu supervisión.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

