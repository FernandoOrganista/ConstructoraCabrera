@{
    ViewData["Title"] = "Nosotros";
    ViewData["ActivePage"] = "About";
    ViewData["PageHeader"] = "Nosotros";
}

<partial name="_PageHeader" />

<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="row gx-3 h-100">
                    <div class="col-6 align-self-start wow fadeInUp" data-wow-delay="0.1s">
                        <img class="img-fluid" src="~/img/about-1.jpg" alt="Constructora Cabrera">
                    </div>
                    <div class="col-6 align-self-end wow fadeInDown" data-wow-delay="0.1s">
                        <img class="img-fluid" src="~/img/about-2.jpg" alt="Obra en ejecución">
                    </div>
                </div>
            </div>
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                <p class="fw-medium text-uppercase text-primary mb-2">Constructora Cabrera</p>
                <h1 class="display-5 mb-4">Empresa de ingeniería y construcción</h1>
                <p class="mb-4">Nacimos para ejecutar proyectos industriales y de infraestructura con disciplina de obra. Hoy operamos con un modelo que prioriza seguridad, calidad y cumplimiento contractual, desde la preconstrucción hasta la puesta en marcha.</p>
                <div class="d-flex align-items-center mb-4">
                    <div class="flex-shrink-0 bg-primary p-4">
                        <h1 class="display-2">25</h1>
                        <h5 class="text-white">Años de</h5>
                        <h5 class="text-white">experiencia</h5>
                    </div>
                    <div class="ms-4">
                        <p><i class="fa fa-check text-primary me-2"></i>Energía e instalaciones</p>
                        <p><i class="fa fa-check text-primary me-2"></i>Obra civil</p>
                        <p><i class="fa fa-check text-primary me-2"></i>Ingeniería mecánica</p>
                        <p><i class="fa fa-check text-primary me-2"></i>Procesos e infraestructura</p>
                        <p class="mb-0"><i class="fa fa-check text-primary me-2"></i>Hidráulica y saneamiento</p>
                    </div>
                </div>
                <div class="row pt-2">
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0 btn-lg-square rounded-circle bg-primary">
                                <i class="fa fa-envelope-open text-white"></i>
                            </div>
                            <div class="ms-3">
                                <p class="mb-2">Correo</p>
                                <h5 class="mb-0">contacto@constructoracabrera.com</h5>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center">
                            <div class="flex-shrink-0 btn-lg-square rounded-circle bg-primary">
                                <i class="fa fa-phone-alt text-white"></i>
                            </div>
                            <div class="ms-3">
                                <p class="mb-2">Teléfono</p>
                                <h5 class="mb-0">+52 55 0000 0000</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

