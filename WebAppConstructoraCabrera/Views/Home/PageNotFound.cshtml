@{
    ViewData["Title"] = "Página no encontrada";
    ViewData["ActivePage"] = "";
    ViewData["PageHeader"] = "404";
}

<partial name="_PageHeader" />

<div class="container-xxl py-5 wow fadeInUp" data-wow-delay="0.1s">
    <div class="container text-center">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <i class="bi bi-exclamation-triangle display-1 text-primary"></i>
                <h1 class="display-1">404</h1>
                <h1 class="mb-4">Página no encontrada</h1>
                <p class="mb-4">La dirección no existe o fue movida. Puedes volver al inicio o usar el menú para continuar.</p>
                <a class="btn btn-primary py-3 px-5" asp-controller="Home" asp-action="Index">Volver al inicio</a>
            </div>
        </div>
    </div>
</div>
