@{
    ViewData["Title"] = "Equipo";
    ViewData["ActivePage"] = "Team";
    ViewData["PageHeader"] = "Equipo";
}

<partial name="_PageHeader" />

<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center mx-auto wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
            <p class="fw-medium text-uppercase text-primary mb-2">Personas</p>
            <h1 class="display-5 mb-5">Quienes lideran tus frentes de obra</h1>
        </div>
        <div class="row g-4">
            @{
                var members = new[]
                {
                    new { Img = "team-1.jpg", Name = "Roberto Cabrera", Role = "Director general" },
                    new { Img = "team-2.jpg", Name = "Ana Morales", Role = "Gerente de proyectos" },
                    new { Img = "team-3.jpg", Name = "Pedro Farel", Role = "Ingeniero residente" },
                    new { Img = "team-1.jpg", Name = "Laura Méndez", Role = "Control de costos" },
                    new { Img = "team-2.jpg", Name = "Jorge Salinas", Role = "Seguridad industrial" },
                    new { Img = "team-3.jpg", Name = "Elena Cruz", Role = "Calidad de obra" }
                };
                var delay = new[] { "0.1s", "0.3s", "0.5s", "0.1s", "0.3s", "0.5s" };
            }
            @for (var i = 0; i < members.Length; i++)
            {
                var m = members[i];
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="@delay[i]">
                    <div class="team-item">
                        <img class="img-fluid" src="~/img/@m.Img" alt="@m.Name">
                        <div class="d-flex">
                            <div class="flex-shrink-0 btn-square bg-primary" style="width: 90px; height: 90px;">
                                <i class="fa fa-2x fa-share text-white"></i>
                            </div>
                            <div class="position-relative overflow-hidden bg-light d-flex flex-column justify-content-center w-100 ps-4" style="height: 90px;">
                                <h5>@m.Name</h5>
                                <span class="text-primary">@m.Role</span>
                                <div class="team-social">
                                    <a class="btn btn-square btn-dark rounded-circle mx-1" href="#"><i class="fab fa-facebook-f"></i></a>
                                    <a class="btn btn-square btn-dark rounded-circle mx-1" href="#"><i class="fab fa-twitter"></i></a>
                                    <a class="btn btn-square btn-dark rounded-circle mx-1" href="#"><i class="fab fa-instagram"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
