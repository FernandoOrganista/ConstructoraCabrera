<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Inicio") - Constructora Cabrera</title>
    <meta name="keywords" content="constructora, ingeniería, obras civiles, proyectos industriales, Constructora Cabrera" />
    <meta name="description" content="Constructora Cabrera: soluciones de ingeniería y construcción con más de 25 años de experiencia." />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600&family=Rubik:wght@500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/animate/animate.min.css" />
    <link rel="stylesheet" href="~/lib/owlcarousel/assets/owl.carousel.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    @{
        var active = ViewData["ActivePage"] as string ?? "";
        string Nav(string page) => string.Equals(active, page, StringComparison.OrdinalIgnoreCase) ? "nav-item nav-link active" : "nav-item nav-link";
        var pagesMenu = new[] { "Projects", "Features", "Team", "Testimonials" };
        var pagesActive = pagesMenu.Contains(active);
    }

    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
    </div>

    <div class="container-fluid bg-dark px-0">
        <div class="row g-0 d-none d-lg-flex">
            <div class="col-lg-6 ps-5 text-start">
                <div class="h-100 d-inline-flex align-items-center text-white">
                    <span>Síguenos:</span>
                    <a class="btn btn-link text-light" href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a class="btn btn-link text-light" href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    <a class="btn btn-link text-light" href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                    <a class="btn btn-link text-light" href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                </div>
            </div>
            <div class="col-lg-6 text-end">
                <div class="h-100 topbar-right d-inline-flex align-items-center text-white py-2 px-5">
                    <span class="fs-5 fw-bold me-2"><i class="fa fa-phone-alt me-2"></i>Llámanos:</span>
                    <span class="fs-5 fw-bold">+52 55 0000 0000</span>
                </div>
            </div>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg bg-white navbar-light sticky-top py-0 pe-5">
        <a asp-controller="Home" asp-action="Index" class="navbar-brand ps-5 me-0">
            <h1 class="text-white m-0">Cabrera</h1>
        </a>
        <button type="button" class="navbar-toggler me-0" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Abrir menú">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto p-4 p-lg-0">
                <a asp-controller="Home" asp-action="Index" class="@Nav("Index")">Inicio</a>
                <a asp-controller="Home" asp-action="About" class="@Nav("About")">Nosotros</a>
                <a asp-controller="Home" asp-action="Services" class="@Nav("Services")">Servicios</a>
                <div class="nav-item dropdown">
                    <a href="#" class="nav-link dropdown-toggle @(pagesActive ? "active" : "")" data-bs-toggle="dropdown">Páginas</a>
                    <div class="dropdown-menu bg-light m-0">
                        <a asp-controller="Home" asp-action="Projects" class="dropdown-item">Proyectos</a>
                        <a asp-controller="Home" asp-action="Features" class="dropdown-item">Por qué elegirnos</a>
                        <a asp-controller="Home" asp-action="Team" class="dropdown-item">Equipo</a>
                        <a asp-controller="Home" asp-action="Testimonials" class="dropdown-item">Testimonios</a>
                    </div>
                </div>
                <a asp-controller="Home" asp-action="Contact" class="@Nav("Contact")">Contacto</a>
            </div>
            <a asp-controller="Home" asp-action="Contact" class="btn btn-primary px-3 d-none d-lg-block">Solicitar cotización</a>
        </div>
    </nav>

    @RenderBody()

    <div class="container-fluid bg-dark footer mt-5 py-5 wow fadeIn" data-wow-delay="0.1s">
        <div class="container py-5">
            <div class="row g-5">
                <div class="col-lg-3 col-md-6">
                    <h5 class="text-white mb-4">Oficina</h5>
                    <p class="mb-2"><i class="fa fa-map-marker-alt me-3"></i>México</p>
                    <p class="mb-2"><i class="fa fa-phone-alt me-3"></i>+52 55 0000 0000</p>
                    <p class="mb-2"><i class="fa fa-envelope me-3"></i>contacto@constructoracabrera.com</p>
                    <div class="d-flex pt-3">
                        <a class="btn btn-square btn-primary rounded-circle me-2" href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                        <a class="btn btn-square btn-primary rounded-circle me-2" href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a class="btn btn-square btn-primary rounded-circle me-2" href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                        <a class="btn btn-square btn-primary rounded-circle me-2" href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="text-white mb-4">Enlaces</h5>
                    <a class="btn btn-link" asp-controller="Home" asp-action="About">Nosotros</a>
                    <a class="btn btn-link" asp-controller="Home" asp-action="Contact">Contacto</a>
                    <a class="btn btn-link" asp-controller="Home" asp-action="Services">Servicios</a>
                    <a class="btn btn-link" asp-controller="Home" asp-action="Privacy">Aviso de privacidad</a>
                    <a class="btn btn-link" asp-controller="Home" asp-action="Contact">Soporte</a>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="text-white mb-4">Horario</h5>
                    <p class="mb-1">Lunes - Viernes</p>
                    <h6 class="text-light">09:00 am - 07:00 pm</h6>
                    <p class="mb-1">Sábado</p>
                    <h6 class="text-light">09:00 am - 12:00 pm</h6>
                    <p class="mb-1">Domingo</p>
                    <h6 class="text-light">Cerrado</h6>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="text-white mb-4">Boletín</h5>
                    <p>Recibe novedades de obra, capacidad técnica y convocatorias de Constructora Cabrera.</p>
                    <div class="position-relative w-100">
                        <input class="form-control bg-transparent w-100 py-3 ps-4 pe-5" type="email" placeholder="Tu correo" aria-label="Correo para boletín">
                        <button type="button" class="btn btn-primary py-2 position-absolute top-0 end-0 mt-2 me-2">Enviar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid copyright bg-dark py-4">
        <div class="container text-center">
            <p class="mb-2">Copyright &copy; @DateTime.Now.Year <a class="fw-semi-bold" asp-controller="Home" asp-action="Index">Constructora Cabrera</a>. Todos los derechos reservados.</p>
            <p class="mb-0">Diseño basado en <a class="fw-semi-bold" href="https://htmlcodex.com">HTML Codex</a>. Distribuido por <a href="https://themewagon.com">ThemeWagon</a>.</p>
        </div>
    </div>

    <a href="#" class="btn btn-lg btn-primary btn-lg-square rounded-circle back-to-top" aria-label="Volver arriba"><i class="bi bi-arrow-up"></i></a>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/wow/wow.min.js"></script>
    <script src="~/lib/easing/easing.min.js"></script>
    <script src="~/lib/waypoints/waypoints.min.js"></script>
    <script src="~/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/lib/counterup/counterup.min.js"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
