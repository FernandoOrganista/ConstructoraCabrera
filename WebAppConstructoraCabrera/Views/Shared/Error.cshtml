@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    ViewData["ActivePage"] = "";
    ViewData["PageHeader"] = "Error";
}

<partial name="_PageHeader" />

<div class="container-xxl py-5 wow fadeInUp" data-wow-delay="0.1s">
    <div class="container text-center">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <i class="bi bi-exclamation-triangle display-1 text-primary"></i>
                <h1 class="mb-4">Ocurrió un error</h1>
                <p class="mb-4">No fue posible completar la solicitud. Intenta de nuevo o regresa al inicio.</p>
                @if (Model.ShowRequestId)
                {
                    <p class="mb-4"><strong>Id de solicitud:</strong> <code>@Model.RequestId</code></p>
                }
                <a class="btn btn-primary py-3 px-5" asp-controller="Home" asp-action="Index">Volver al inicio</a>
            </div>
        </div>
    </div>
</div>
